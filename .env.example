# =====================================================================
# J-Bridge — 環境変数テンプレート
# =====================================================================
# このファイルをコピーして `.env.local` を作成してください。
#   cp .env.example .env.local
#
# `.env.local` は `.gitignore` 済 — 絶対に commit しないこと。
# 本番・CI のシークレットは GitHub Repository → Settings → Secrets and variables → Actions
# を Source of Truth として管理しています (デプロイ先ホストへ同期)。
# 鍵のローテーション手順は docs/SECRETS_ROTATION.md 参照。
# =====================================================================

# ---------- Supabase ----------
# 取得元: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-jwt

# RLS をバイパスする管理者キー (一部の管理機能で必須)
# 致命的キー — 漏洩時は即時 Reset
SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt

# ---------- Judge0 (コード自動採点) ----------
# self-hosted の場合: http://your-judge0-host:2358
# RapidAPI の場合: https://judge0-ce.p.rapidapi.com
JUDGE0_API_URL=http://localhost:2358

# self-hosted: AUTHN_TOKEN, RapidAPI: X-RapidAPI-Key
# 空文字列の場合 = 認証なし (self-hosted の open mode 用)
JUDGE0_API_KEY=

# ---------- Google Cloud Text-to-Speech ----------
# 取得元: https://console.cloud.google.com/apis/credentials
# Cloud Text-to-Speech API のみに制限し、HTTP リファラまたは IP 制限を設定すること
GOOGLE_CLOUD_TTS_API_KEY=your-google-tts-api-key

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
nul

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# TTS audio cache
/public/audio

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# (architecture docs are now committed for handover — see docs/ARCHITECTURE.md)

# migration apply backups (one-off scripts under scripts/)
.backup-*.json

# personal handover briefing notes (local only)
/BRIEFING_NOTES.md

# Docker image exports (NAS deployment artifacts, never commit)
*.tar
*.tar.gz

# Claude Code local settings (contains machine-local permission allowlist; may hold secrets)
.claude/settings.local.json

# Local content export artifacts (TSV/TXT dumps — regenerated locally, not for repo)
/_export/

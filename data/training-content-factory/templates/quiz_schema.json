{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuizSchema",
  "type": "object",
  "required": [
    "version",
    "lesson_id",
    "questions"
  ],
  "properties": {
    "version": {
      "type": "integer"
    },
    "lesson_id": {
      "type": "string"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "difficulty",
          "prompt",
          "explanation"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "single_choice",
              "multi_choice",
              "true_false",
              "short_answer",
              "code_output"
            ]
          },
          "difficulty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "prompt": {
            "type": "string"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "answer": {},
          "code": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
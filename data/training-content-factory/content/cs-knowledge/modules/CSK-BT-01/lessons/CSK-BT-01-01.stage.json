{
  "version": 1,
  "ja": {
    "hook": {
      "title": "コンピュータが数える仕組み",
      "prompt": "コンピュータはなぜ0と1だけで計算できるのでしょうか？",
      "takeaway": "2進数とビット・バイトの関係を理解し、10進数との変換ができるようになる"
    },
    "steps": [
      {
        "id": "basic-theory-01-concept-1",
        "type": "concept",
        "title": "2進数とは",
        "body": "2進数は0と1の2つの数字だけで数を表す方法です。コンピュータの内部では電圧の高低（ON/OFF）で情報を扱うため、2進数が最も自然な表現になります。",
        "bullets": [
          "10進数の「5」は2進数で「101」（4+0+1）",
          "各桁は右から2⁰, 2¹, 2², … の重みを持つ"
        ]
      },
      {
        "id": "basic-theory-01-mini-1",
        "type": "mini_check",
        "title": "確認1",
        "prompt": "2進数「1010」を10進数に変換すると？",
        "options": [
          { "id": "A", "text": "10（8+0+2+0）" },
          { "id": "B", "text": "12（8+4+0+0）" },
          { "id": "C", "text": "5（4+0+0+1）" }
        ],
        "correctOptionId": "A",
        "explanation": "1×2³ + 0×2² + 1×2¹ + 0×2⁰ = 8+0+2+0 = 10です。各桁の重みを掛けて合計します。"
      },
      {
        "id": "basic-theory-01-concept-2",
        "type": "concept",
        "title": "ビットとバイト",
        "body": "ビット（bit）は2進数の1桁で、情報の最小単位です。8ビットをまとめて1バイト（byte）と呼び、コンピュータのメモリやファイルサイズの基本単位になります。",
        "bullets": [
          "1ビットで0か1の2通り、8ビット（1バイト）で256通りの値を表現できる",
          "KB（キロバイト）= 1,024バイト、MB = 1,024KB、GB = 1,024MB"
        ]
      },
      {
        "id": "basic-theory-01-mini-2",
        "type": "mini_check",
        "title": "確認2",
        "prompt": "1バイトで表現できる値の範囲は何通り？",
        "options": [
          { "id": "A", "text": "256通り（2⁸）" },
          { "id": "B", "text": "128通り（2⁷）" },
          { "id": "C", "text": "8通り（2³）" }
        ],
        "correctOptionId": "A",
        "explanation": "1バイト = 8ビットなので、2⁸ = 256通りの値を表現できます。0〜255の範囲です。"
      },
      {
        "id": "basic-theory-01-worked",
        "type": "worked_example",
        "title": "10進数から2進数への変換",
        "situation": "10進数の「13」を2進数に変換してみましょう。",
        "reasoning": [
          "13 ÷ 2 = 6 余り 1",
          "6 ÷ 2 = 3 余り 0",
          "3 ÷ 2 = 1 余り 1",
          "1 ÷ 2 = 0 余り 1 → 余りを逆順に並べて「1101」"
        ],
        "takeaway": "2で割り続けて余りを逆順に並べると2進数になる。検算：1×8 + 1×4 + 0×2 + 1×1 = 13 ✓"
      },
      {
        "id": "basic-theory-01-mini-3",
        "type": "mini_check",
        "title": "確認3",
        "prompt": "10進数「7」を2進数に変換すると？",
        "options": [
          { "id": "A", "text": "111（4+2+1）" },
          { "id": "B", "text": "110（4+2+0）" },
          { "id": "C", "text": "1000（8）" }
        ],
        "correctOptionId": "A",
        "explanation": "7 = 4+2+1 = 1×2² + 1×2¹ + 1×2⁰ なので「111」です。"
      },
      {
        "id": "basic-theory-01-apply-1",
        "type": "apply_check",
        "title": "応用1",
        "prompt": "画像ファイルの1ピクセルがRGB各8ビットで表現される場合、1ピクセルあたり何バイト必要？",
        "options": [
          { "id": "A", "text": "3バイト（8ビット × 3色 = 24ビット = 3バイト）" },
          { "id": "B", "text": "8バイト（各色1バイトではない）" },
          { "id": "C", "text": "1バイト（全色まとめて8ビット）" }
        ],
        "correctOptionId": "A",
        "explanation": "R, G, B各色8ビット = 計24ビット = 3バイトです。1920×1080の画像なら約6MB（無圧縮）になります。"
      },
      {
        "id": "basic-theory-01-apply-2",
        "type": "apply_check",
        "title": "応用2",
        "prompt": "4ビットで表現できる最大の10進数はいくつ？",
        "options": [
          { "id": "A", "text": "15（1111₂ = 8+4+2+1）" },
          { "id": "B", "text": "16（2⁴）" },
          { "id": "C", "text": "9（1001₂）" }
        ],
        "correctOptionId": "A",
        "explanation": "4ビットの全桁が1の場合「1111」= 15が最大です。2⁴=16は通り数であり、値の範囲は0〜15です。"
      },
      {
        "id": "basic-theory-01-summary",
        "type": "summary",
        "title": "学んだこと",
        "bullets": [
          "2進数は0と1だけで数を表し、コンピュータの基本",
          "各桁は2のべき乗の重みを持ち、10進数と相互変換できる",
          "ビットは情報の最小単位、8ビット = 1バイト",
          "1バイトで256通り（0〜255）の値を表現できる"
        ]
      }
    ],
    "referenceLabel": "参考ノートを見る"
  },
